# TMDB (required) - v3 API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
LANGUAGE=cs-CZ

# TorrServer as seen from the app (docker-compose overrides this)
TORRSERVER_URL=http://127.0.0.1:8090
# TorrServer as seen from the browser; empty = same host as the app, port 8090
TORRSERVER_PUBLIC_URL=

# Subtitles - preferred languages in order (the first available one is loaded automatically)
SUBTITLE_LANGUAGES=cs,sk,en
# Optional free API key (https://www.opensubtitles.com/consumers): adds exact matching by file hash.
# Without it subtitles still come from OpenSubtitles.org and from the torrent itself.
OPENSUBTITLES_API_KEY=
# Optional login: only needed for subtitles that exist solely on the .com API (5 -> 20 a day)
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# ffmpeg converts unsupported audio (AC3/DTS) and matches subtitles to speech.
# Leave empty: found automatically (PATH, or the imageio-ffmpeg package on Windows/macOS).
# Docker, the Raspberry Pi and Termux install ffmpeg themselves.
FFMPEG_PATH=
FFPROBE_PATH=

# Flask
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
